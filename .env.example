# Copy to .env.local and fill in from your Supabase project (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for public form inserts, order placement and owner provisioning.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm run create-owner`
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Payments: intentionally unset. Checkout runs as a clearly-labelled order request until a provider is integrated.
# Email: unset => no confirmation emails are sent and the UI says so.
